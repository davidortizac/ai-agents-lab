# ── Ollama ───────────────────────────────────────────────────────────────────
# Docker:  http://host.docker.internal:11434
# WSL/local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Volume paths (inside container) ──────────────────────────────────────────
WORKSPACE_PATH=/app/workspace
MEMORY_PATH=/app/memory

# ── Skills — set to false to disable a skill entirely ────────────────────────
SKILL_FILESYSTEM=true
SKILL_CODE_RUNNER=true
SKILL_FORTIGATE=true
SKILL_MEMORY=true
SKILL_LOG_ANALYSIS=true

# ── FortiGate connection ──────────────────────────────────────────────────────
FORTIGATE_HOST=192.168.1.1
FORTIGATE_PORT=443
FORTIGATE_TOKEN=your-api-token-here
FORTIGATE_VDOM=root
FORTIGATE_VERIFY_SSL=false
FORTIGATE_ALLOW_WRITES=false
